<%- include('partials/header') %>

<main class="container">
  <section class="search-header">
    <h1>Search Results</h1>
    <p class="search-query">You searched for: <strong>"<%= searchQuery %>"</strong></p>
    
    <form method="POST" action="/search" class="search-form">
      <div class="search-input-group">
        <input 
          type="text" 
          name="query" 
          placeholder="Search for something else..." 
          class="search-input"
          value="<%= searchQuery %>"
          required
        />
        
        <select name="type" class="search-type">
          <option value="track" <%= type === 'track' ? 'selected' : '' %>>Tracks</option>
          <option value="artist" <%= type === 'artist' ? 'selected' : '' %>>Artists</option>
          <option value="album" <%= type === 'album' ? 'selected' : '' %>>Albums</option>
          <option value="all" <%= type === 'all' ? 'selected' : '' %>>All</option>
        </select>
        
        <button type="submit" class="btn btn-primary">
          <span class="search-icon">🔍</span> Search Again
        </button>
      </div>
    </form>
  </section>

  <% if (error) { %>
    <div class="alert alert-error">
      <span class="alert-icon">⚠️</span>
      <div class="alert-content">
        <p><strong>No Results</strong> <%= error %></p>
        <p class="error-suggestion">Try adjusting your search terms or filters</p>
      </div>
    </div>
  <% } else if (results) { %>
    
    <!-- Tracks Section -->
    <% if (results.tracks && results.tracks.length > 0) { %>
      <section class="results-section">
        <h2 class="section-title">Tracks</h2>
        <div class="results-grid">
          <% results.tracks.forEach(track => { %>
            <div class="result-card track-card">
              <% if (track.album && track.album.images && track.album.images[0]) { %>
                <div class="card-image">
                  <img src="<%= track.album.images[0].url %>" alt="<%= track.name %>">
                </div>
              <% } else { %>
                <div class="card-image placeholder">
                  <span class="placeholder-icon">🎵</span>
                </div>
              <% } %>
              
              <div class="card-content">
                <h3 class="card-title"><%= track.name %></h3>
                <p class="card-subtitle">
                  <% if (track.artists && track.artists.length > 0) { %>
                    <a href="/artist/<%= track.artists[0].id %>" class="artist-link">
                      <%= track.artists[0].name %>
                    </a>
                  <% } %>
                </p>
                <p class="card-meta">
                  <% if (track.album) { %>
                    <%= track.album.name %>
                  <% } %>
                  <% if (track.release_date) { %>
                    • <%= new Date(track.release_date).getFullYear() %>
                  <% } %>
                </p>
                
                <% if (track.preview_url) { %>
                  <audio controls class="audio-player">
                    <source src="<%= track.preview_url %>" type="audio/mpeg">
                    Your browser does not support the audio element.
                  </audio>
                <% } else { %>
                  <p class="no-preview">Preview not available</p>
                <% } %>
                
                <a href="https://open.spotify.com/track/<%= track.id %>" target="_blank" class="btn btn-spotify" rel="noopener noreferrer">
                  Listen on Spotify
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Artists Section -->
    <% if (results.artists && results.artists.length > 0) { %>
      <section class="results-section">
        <h2 class="section-title">Artists</h2>
        <div class="results-grid">
          <% results.artists.forEach(artist => { %>
            <div class="result-card artist-card">
              <% if (artist.images && artist.images[0]) { %>
                <div class="card-image">
                  <img src="<%= artist.images[0].url %>" alt="<%= artist.name %>">
                </div>
              <% } else { %>
                <div class="card-image placeholder">
                  <span class="placeholder-icon">🎤</span>
                </div>
              <% } %>
              
              <div class="card-content">
                <h3 class="card-title"><%= artist.name %></h3>
                
                <% if (artist.genres && artist.genres.length > 0) { %>
                  <p class="card-meta">
                    <%= artist.genres.slice(0, 2).join(', ') %>
                  </p>
                <% } %>
                
                <% if (artist.followers) { %>
                  <p class="card-meta">
                    <strong><%= artist.followers.total.toLocaleString() %></strong> followers
                  </p>
                <% } %>
                
                <a href="/artist/<%= artist.id %>" class="btn btn-secondary">View Details</a>
                <a href="https://open.spotify.com/artist/<%= artist.id %>" target="_blank" class="btn btn-spotify" rel="noopener noreferrer">
                  View on Spotify
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Albums Section -->
    <% if (results.albums && results.albums.length > 0) { %>
      <section class="results-section">
        <h2 class="section-title">Albums</h2>
        <div class="results-grid">
          <% results.albums.forEach(album => { %>
            <div class="result-card album-card">
              <% if (album.images && album.images[0]) { %>
                <div class="card-image">
                  <img src="<%= album.images[0].url %>" alt="<%= album.name %>">
                </div>
              <% } else { %>
                <div class="card-image placeholder">
                  <span class="placeholder-icon">💿</span>
                </div>
              <% } %>
              
              <div class="card-content">
                <h3 class="card-title"><%= album.name %></h3>
                <p class="card-subtitle">
                  <% if (album.artists && album.artists.length > 0) { %>
                    <a href="/artist/<%= album.artists[0].id %>" class="artist-link">
                      <%= album.artists[0].name %>
                    </a>
                  <% } %>
                </p>
                <p class="card-meta">
                  <% if (album.release_date) { %>
                    <%= new Date(album.release_date).getFullYear() %>
                  <% } %>
                  <% if (album.total_tracks) { %>
                    • <%= album.total_tracks %> tracks
                  <% } %>
                </p>
                
                <a href="https://open.spotify.com/album/<%= album.id %>" target="_blank" class="btn btn-spotify" rel="noopener noreferrer">
                  View on Spotify
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

  <% } %>
</main>

<%- include('partials/footer') %>
