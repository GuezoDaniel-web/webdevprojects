<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="<%= post.title %> - Magazine Blog">
        <title><%= post.title %> - Magazine</title>
        <link rel="stylesheet" href="/css/styles.css">
    </head>

    <body>
        <div class="container">
            <!-- Sidebar Navigation -->
            <aside class="sidebar">
                <div class="logo">
                    <h1>📝 MAGAZINE</h1>
                </div>
                
                <nav class="nav-menu">
                    <a href="/" class="nav-link">
                        <span class="nav-icon">🏠</span>
                        <span class="nav-text">Home</span>
                    </a>
                    <a href="/" class="nav-link">
                        <span class="nav-icon">🔍</span>
                        <span class="nav-text">Explore</span>
                    </a>
                    <a href="/" class="nav-link">
                        <span class="nav-icon">🔔</span>
                        <span class="nav-text">Notifications</span>
                    </a>
                    <a href="/create" class="nav-link">
                        <span class="nav-icon">✉️</span>
                        <span class="nav-text">Messages</span>
                    </a>
                </nav>

                <a href="/" class="btn-compose">
                    ← Back to Home
                </a>
            </aside>

            <!-- Main Content -->
            <main class="feed post-view">
                <!-- Post Header -->
                <div class="post-header-full">
                    <a href="/" class="breadcrumb">Home</a>
                    <h1 class="post-title-full"><%= post.title %></h1>
                    <div class="post-meta">
                        <span class="post-author">👤 Author</span>
                        <span class="post-date">Published Just Now</span>
                        <span class="post-id">Post ID: <%= post.id %></span>
                    </div>
                </div>

                <!-- Post Content -->
                <article class="post-content-full">
                    <p><%= post.content %></p>
                </article>

                <!-- Post Actions -->
                <div class="post-actions-full">
                    <a href="/" class="btn-action secondary">
                        ← Go Back
                    </a>
                    
                    <a href="/posts/<%= post.id %>/edit" class="btn-action secondary">
                        ✏️ Edit Post
                    </a>
                    
                    <form action="/delete/<%= post.id %>" method="POST" class="delete-form-inline" onsubmit="return confirm('Are you sure you want to delete this post? This action cannot be undone.');">
                        <button type="submit" class="btn-action danger">
                            🗑️ Delete Post
                        </button>
                    </form>
                </div>

                <!-- Related Posts Section (Optional) -->
                <section class="related-posts">
                    <h3>More from Magazine</h3>
                    <p class="no-data">Check out the home feed for more posts</p>
                    <a href="/" class="btn-explore">Explore All Posts</a>
                </section>
            </main>

            <!-- Right Sidebar -->
            <aside class="right-sidebar">
                <div class="info-box">
                    <h3>📊 Post Statistics</h3>
                    <ul>
                        <li>Post ID: <strong><%= post.id %></strong></li>
                        <li>Status: <strong>Published</strong></li>
                        <li>Created: <strong>Just Now</strong></li>
                    </ul>
                </div>
                <div class="info-box">
                    <h3>🎯 Quick Actions</h3>
                    <ul>
                        <li><a href="/">View All Posts</a></li>
                        <li><a href="/create">Write New Post</a></li>
                    </ul>
                </div>
            </aside>
        </div>

        <footer class="app-footer">
            <p>&copy; 2026 The MAGAZINE. All rights reserved.</p>
        </footer>

        <script>
            // Smooth scroll behavior
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });
        </script>
    </body>
</html>
